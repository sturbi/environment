[global_config]
  handle_size = 3
  sticky = True
  inactive_color_offset = 0.75
  title_transmit_bg_color = "#dc322f"
  title_transmit_fg_color = "#ffffff"

[keybindings]
  broadcast_all = <Alt>a
  broadcast_off = <Alt>g
  broadcast_group = <Alt>o

[profiles]
  [[default]]
    background_color = "#272822"
    background_image = None
    font = Hack Nerd Font Propo 14
    foreground_color = "#d0d0d0"
    scrollback_infinite = True
    palette = "#272822:#d0d0d0:#66aa11:#c47f2c:#1c71d8:#9141ac:#3579a8:#9999aa:#303030:#ff0090:#80ff00:#ffba68:#1a5fb4:#bb88dd:#4eb4fa:#ffffff"
    use_system_font = False
    show_titlebar = True

[layouts]
  [[default]]
    [[[child1]]]
      parent = window0
      profile = default
      type = Terminal
    [[[window0]]]
      parent = ""
      size = 1600, 800
      type = Window

[plugins]
